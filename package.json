{
  "name": "netxjs-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts",
      "tools/oxlint/anti-slop"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bunx --bun ultracite check --type-aware",
    "dev": "turbo dev",
    "fix": "bunx --bun ultracite fix --type-aware",
    "format": "bun run fix",
    "lint": "bun run check",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "upgrade": "bun run scripts/upgrade.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "^1.4.4",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "portless": "^0.15.13",
    "tsrs": "^0.23.0-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
