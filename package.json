{
  "name": "netxjs-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts",
      "tools/oxlint/anti-slop"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bunx --bun ultracite check --type-aware",
    "dev": "turbo dev",
    "fix": "bunx --bun ultracite fix --type-aware",
    "format": "bun run fix",
    "lint": "bun run check",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "upgrade": "bun run scripts/upgrade.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "^1.3.14",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "^0.15.4",
    "turbo": "^2.10.11",
    "typescript": "7.0.2",
    "ultracite": "7.10.5"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14"
}
